{% doc %}
NW brand tokens, font overrides, and self-hosted `@font-face` rules for 
Ambroise Std Francois, Lovelo, and Owners Wide. Render in the head.
{% enddoc %}

{% style %}

:root {
  /* ===========================
     Sun & Sand Colors
  =========================== */
  --nw-sunset-yellow: #FDAE0F;
  --nw-sun-deep: #D78A15;
  --nw-cream-soft: #F8F1DE;
  --nw-cream: #F3E8D2;
  --nw-cream-deep: #E4D7B1;

  /* ===========================
     Cool Anchors
  =========================== */
  --nw-bb-blue: #1E3A5F;
  --nw-night: #13233E;
  --nw-sky: #5795CE;

  /* ===========================
     Warm Espresso
  =========================== */
  --nw-espresso: #3A2418;
  --nw-cocoa: #6B4427;
  --nw-caramel: #C79459;
  --nw-bone: #FCF7EB;
  --nw-paper: #FFFEFA;

  /* ===========================
     Sun Balm
  =========================== */
  --nw-soft-balm: #FFEBC2;
  --nw-bronze: #AE7445;
  --nw-dark-balm: #5C413F;

  /* ===========================
     Black & White
  =========================== */
  --nw-black: #000000;
  --nw-white: #FFFFFF;


  /* ===========================
     Reusable Color Variables
  =========================== */
  --sunset-yellow: var(--nw-sunset-yellow);
  --sun-deep: var(--nw-sun-deep);
  --cream-soft: var(--nw-cream-soft);
  --cream: var(--nw-cream);
  --cream-deep: var(--nw-cream-deep);

  --bb-blue: var(--nw-bb-blue);
  --night: var(--nw-night);
  --sky: var(--nw-sky);

  --espresso: var(--nw-espresso);
  --cocoa: var(--nw-cocoa);
  --caramel: var(--nw-caramel);
  --bone: var(--nw-bone);
  --paper: var(--nw-paper);

  --soft-balm: var(--nw-soft-balm);
  --bronze: var(--nw-bronze);
  --dark-balm: var(--nw-dark-balm);

  --black: var(--nw-black);
  --white: var(--nw-white);


     /* ===========================
     font-families
  =========================== */
    --font-body-family: 'Owners Wide', sans-serif;
  --font-accent-family: 'Ambroise Francois', serif;
  --font-heading-family: 'Lovelo', sans-serif;    


}

