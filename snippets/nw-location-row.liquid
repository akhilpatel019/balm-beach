{% comment %}
  Renders a single location/event row in the NW Location Table section.

  @param {object} block - Section block object of type 'nw-location-row'
  @param {number} [index] - 1-based loop index for Dawn cascade animation
{% endcomment %}

<div
  class="nw-location-row{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
    style="--animation-order: {{ index | default: 1 }};"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="nw-location-row__city">
    {%- if block.settings.title != blank -%}
      {{ block.settings.title }}
    {%- endif -%}
  </div>

  <div class="nw-location-row__date">
    {%- if block.settings.event_date != blank -%}
      {{ block.settings.event_date }}
    {%- endif -%}
  </div>

  <div class="nw-location-row__venue">
    {%- if block.settings.event_venue != blank -%}
      {{ block.settings.event_venue }}
    {%- endif -%}
  </div>

  <div class="nw-location-row__action">
    {%- if block.settings.event_registration_label != blank -%}
      {%- if block.settings.event_registration_url != blank -%}
        <a href="{{ block.settings.event_registration_url }}" class="nw-location-row__link">
          {{ block.settings.event_registration_label | escape }}
        </a>
      {%- else -%}
        <span class="nw-location-row__link" aria-disabled="true">
          {{ block.settings.event_registration_label | escape }}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
