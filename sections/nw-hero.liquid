    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>Skin care that smells like beach days and melts into your skin.</p>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "id": "heading_color_normal",
      "label": "Normal Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color_highlighted",
      "label": "Highlighted Heading Color",
      "default": "#F2A93B"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "BUTTON CONTENT"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOP THE SUMMER DROP"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button Type",
      "default": "primary",
      "options": [
        {
          "label": "Primary",
          "value": "primary"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "btn_icon",
      "label": "Show Button Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "SECTION HEIGHT"
    },
    {
      "type": "select",
      "id": "height_type",
      "label": "Height Type",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "Fill Height (Viewport)"
        },
        {
          "value": "fixed",
          "label": "Fixed Height (Pixels)"
        }
      ]
    },
    {
      "type": "range",
      "id": "fixed_height",
      "label": "Fixed Height",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
  "type": "header",
  "content": "BACKGROUND"
},
{
  "type": "select",
  "id": "bg_type",
  "label": "Background Type",
  "default": "image",
  "options": [
    {
      "value": "none",
      "label": "None (Transparent)"
    },
    {
      "value": "color",
      "label": "Solid Color"
    },
    {
      "value": "gradient",
      "label": "Gradient"
    },
    {
      "value": "image",
      "label": "Image"
    }
  ]
},
{
  "type": "color",
  "id": "bg_color",
  "label": "Background Color",
  "default": "#1A1A1A",
  "visible_if": "{{ section.settings.bg_type == 'color' }}"
},
{
  "type": "color_background",
  "id": "bg_gradient",
  "label": "Background Gradient",
  "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
},
{
  "type": "image_picker",
  "id": "bg_image",
  "label": "Desktop Background Image",
  "visible_if": "{{ section.settings.bg_type == 'image' }}"
},
{
  "type": "image_picker",
  "id": "bg_image_mobile",
  "label": "Mobile Background Image",
  "visible_if": "{{ section.settings.bg_type == 'image' }}"
},

{
  "type": "header",
  "content": "BACKGROUND OVERLAY"
},
{
  "type": "checkbox",
  "id": "overlay_enabled",
  "label": "Enable Background Overlay",
  "default": true
},
{
  "type": "color",
  "id": "overlay_color",
  "label": "Overlay Color",
  "default": "#000000"
},
{
  "type": "range",
  "id": "overlay_opacity",
  "label": "Overlay Opacity",
  "min": 0,
