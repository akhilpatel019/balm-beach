{% assign shell_selector = '.nw-collection.section-' | append: section.id %}
{% render 'nw-section-shell', selector: shell_selector %}

{{ 'nw-collection.css' | asset_url | stylesheet_tag }}

<div class="nw-collection section-{{ section.id }}">
  <div class="page-width">
    {%- assign header_anim_class = '' -%}
    {%- if settings.animations_reveal_on_scroll -%}
      {%- assign header_anim_class = 'scroll-trigger animate--slide-in' -%}
    {%- endif -%}
    {% render 'nw-section-header', class: header_anim_class %}

    <div class="nw-collection__grid">
      {% assign nw_collection = section.settings.selected_collection %}

      {% if nw_collection != blank %}
        {% for product in nw_collection.products reversed %}
          <div
            class="nw-collection_card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <!-- Product Image & Badge -->
            <div class="nw-collection_img_wrapper">
              {% assign product_badge = product.metafields.custom.product_color_badge.value
                | first
                | downcase
                | strip
              %}

              {% if product_badge != blank %}
                <div
                  class="nw-product_ad"
                  style="
                    {% case product_badge %}
                      {% when 'unscented' %}
                        background-color: #4E8197;
                      {% when 'orange sherbert scent' %}
                        background-color: #F75D02;
                      {% when 'cacao scent' %}
                        background-color: #AE7445;
                      {% when 'beach day scent' %}
                        background-color: #5795CE;
                      {% else %}
                        background-color: #4d7a88;
                    {% endcase %}
                  "
                >
                  {{ product_badge }}
                </div>
              {% endif %}

              <div class="product-img_wrapper">
                {% if product.featured_image != blank %}
                  <img
                    class="nw-collection_card_image"
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    loading="lazy"
                  >
                {% endif %}
                {% assign seller_badge = product.metafields.custom.product_badges.value | first %}

                {% if seller_badge != blank %}
                  <div class="product_seller_tag">
                    <p class="best_seller_tag">{{ seller_badge }}</p>
                  </div>
                {% endif %}
              </div>
            </div>

            <!-- Product Title & Price -->
            <div class="nw-collection_card_title_price">
              <div class="product_title">
                {{ product.title | escape }}
              </div>

              <div class="product_price">
                {{ product.price | money }}
              </div>
            </div>

            <!-- Product Rating & Review -->
            <div class="nw-collection_card_rating_wrapper">
              {% assign rating = product.metafields.custom.product_rating.value.rating %}

              {% assign rating_data = product.metafields.custom.product_rating.value %}

              {% if rating_data != blank %}
                {% assign rating = rating_data.rating | plus: 0 %}
                {% assign full_stars = rating | floor %}

                {% if full_stars > 0 %}
                  <div class="product_rating_start">
                    {% for i in (1..full_stars) %}
                      <img
                        src="{{ 'rating-star.svg' | asset_url }}"
                        alt="Star"
                        width="18"
                        height="18"
                        loading="lazy"
                      >
                    {% endfor %}
                  </div>
                {% endif %}
              {% endif %}

              {% if product.metafields.custom.product_review.value != blank %}
                <div class="product_review">{{ product.metafields.custom.product_review.value | floor }} Reviews</div>
              {% endif %}
            </div>

            <!-- Product Description -->
            <div class="nw-collection_card_description">
              {% if product.description != blank %}
                <div class="product_desc">
                  {{ product.description | strip_html | truncate: 120 }}
                </div>
              {% endif %}
            </div>

            <!-- Add to Cart Button -->
            <div class="nw-collection_card_cart_btn">
              {% if product.available %}
                {% assign first_available_variant = product.first_available_variant %}

                <form action="{{ routes.cart_add_url }}" method="post">
                  <input
                    type="hidden"
                    name="id"
                    value="{{ first_available_variant.id }}"
                  >

                  <input
                    type="hidden"
                    name="quantity"
                    value="1"
                  >

                  <button type="submit" class="nw-shop-now-btn">Shop Now</button>
                </form>

              {% else %}
                <button
                  type="button"
                  class="nw-shop-now-btn nw-out-of-stock"
                  disabled
                >
                  Out of Stock
                </button>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div
            class="nw-collection_card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <!-- Product Image & Badge -->
            <div class="nw-collection_img_wrapper">
              <div class="nw-product_ad" style="background-color: #4E8197;">Ad Text</div>

              <div class="product-img_wrapper">
                {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'nw-collection_card_image placeholder-svg' }}
                <div class="product_seller_tag">
                  <p class="best_seller_tag">Best Seller</p>
                </div>
              </div>
            </div>

            <!-- Product Title & Price -->
            <div class="nw-collection_card_title_price">
              <div class="product_title">Product Title</div>

              <div class="product_price">
                {{ 4000 | money }}
              </div>
            </div>

            <!-- Product Rating & Review -->
            <div class="nw-collection_card_rating_wrapper">
              <div class="product_rating_start">
                {% for star in (1..5) %}
                  <img
                    src="{{ 'rating-star.svg' | asset_url }}"
                    alt="Star"
                    width="18"
                    height="18"
                    loading="lazy"
                  >
                {% endfor %}
              </div>

              <div class="product_review">581 Reviews</div>
            </div>

            <!-- Product Description -->
            <div class="nw-collection_card_description">
              <div class="product_desc">Product Description</div>
            </div>

            <!-- Add to Cart Button -->
            <div class="nw-collection_card_cart_btn">
              <button type="button" class="nw-shop-now-btn" disabled>Shop Now</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

{% if section.settings.show-hide-btn %}
    <div class="nw-collection_btn_wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
       {% render 'nw-button',
            text: section.settings.button_text,
            link: section.settings.button_link,
            type: section.settings.button_type,
            icon: section.settings.btn_icon,
            align: section.settings.button_alignment
          %}
    </div>
{% endif %}

  </div>
</div>

{% schema %}
{
  "name": "NW Collection",
  "tag": "section",
  "class": "section",
  "settings": [

    {
      "type": "header",
      "content": "COLLECTION"
    },
    {
      "type": "collection",
      "id": "selected_collection",
      "label": "Select Collection"
    },
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "COLLECTION"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Collection Description....</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "HEADER COLORS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
     {
        "type": "header",
        "content": "CTA BUTTON"
    },
    {
        "type": "checkbox",
        "label": "Show/Hide",
        "default": false,
        "id": "show-hide-btn"
    },
   {
  "type": "text",
  "id": "button_text",
  "label": "Button Label",
  "default": "shop all skin care",
  "visible_if": "{{ section.settings.show-hide-btn == true }}"
},
{
  "type": "url",
  "id": "button_link",
  "label": "Button Link",
  "visible_if": "{{ section.settings.show-hide-btn == true }}"
},
{
  "type": "select",
  "id": "button_type",
  "label": "Button Type",
  "default": "primary",
  "options": [
    {
      "label": "Primary",
      "value": "primary"
    },
    {
      "label": "Secondary",
      "value": "secondary"
    }
  ],
  "visible_if": "{{ section.settings.show-hide-btn == true }}"
},
{
      "type": "checkbox",
      "id": "btn_icon",
      "label": "Show Button Arrow Icon",
      "default": true,
       "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
   {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None (Transparent)"
        },
        {
          "value": "color",
          "label": "Solid Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E8D2",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Desktop Background Image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Mobile Background Image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Top Padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Bottom Padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "NW Collection",
      "category": "NW SECTIONS"
    }
  ]
}
{% endschema %}
