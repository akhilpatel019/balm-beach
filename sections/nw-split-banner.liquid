{% assign shell_selector = '.nw-split-banner.section-' | append: section.id %}
{% render 'nw-section-shell', selector: shell_selector, extra: 'padding-top: 0; padding-bottom: 0;' %}
{{ 'nw-split-banner.css' | asset_url | stylesheet_tag }}

{% style %}
  .nw-split-banner_content{
              padding-top: {{section.settings.padding_top_mobile_banner}}px;
              padding-bottom: {{section.settings.padding_bottom_mobile_banner}}px;
  }

       @media screen and (min-width: 990px) {
          .nw-split-banner_content{
              padding-top: {{section.settings.padding_top_desktop_banner}}px;
              padding-bottom: {{section.settings.padding_bottom_desktop_banner}}px;
          }
       }
{% endstyle %}



<div class="nw-split-banner section-{{ section.id }}">
  <div class="nw-split-banner_wrapper">
    <div class="nw-split-banner_image{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {% if section.settings.banner_image != blank or section.settings.banner_image_mobile != blank %}
        <picture>
          {% if section.settings.banner_image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.banner_image_mobile | image_url: width: 800 }}"
            >
          {% endif %}

          {% if section.settings.banner_image != blank %}
            <img
              src="{{ section.settings.banner_image | image_url: width: 1920 }}"
              alt="{{ section.settings.banner_image.alt | default: section.settings.banner_image_mobile.alt | escape }}"
              width="{{ section.settings.banner_image.width }}"
              height="{{ section.settings.banner_image.height }}"
              loading="lazy"
            >
          {% elsif section.settings.banner_image_mobile != blank %}
            <img
              src="{{ section.settings.banner_image_mobile | image_url: width: 800 }}"
              alt="{{ section.settings.banner_image_mobile.alt | escape }}"
              width="{{ section.settings.banner_image_mobile.width }}"
              height="{{ section.settings.banner_image_mobile.height }}"
              loading="lazy"
            >
          {% endif %}
        </picture>
      {% else %}
        <img
          class="nw-split-banner_placeholder"
          src="{{ 'banner_placeholder_img.webp' | asset_url }}"
          alt="{{ section.settings.heading | default: 'Banner placeholder' | escape }}"
          width="1200"
          height="1200"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="nw-split-banner_content">
      <div class="banner_content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {% render 'nw-section-header' %}
        {% if section.settings['show-hide-btn'] %}
          {% render 'nw-button',
            text: section.settings.button_text,
            link: section.settings.button_link,
            type: section.settings.button_type,
            icon: section.settings.btn_icon
          %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW Split Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "BANNER IMAGE"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Image(Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Image(Mobile)"
    },
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "HEADING"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Description....</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "HEADER COLORS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "header",
      "content": "CTA BUTTON"
    },
    {
      "type": "checkbox",
      "label": "Show/Hide",
      "default": false,
      "id": "show-hide-btn"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Shop all skin balms",
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button Type",
      "default": "primary",
      "options": [
        {
          "label": "Primary",
          "value": "primary"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        }
      ],
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "checkbox",
      "id": "btn_icon",
      "label": "Show Button Arrow Icon",
      "default": true,
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "header",
      "content": "BANNER CONTENT SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop_banner",
      "label": "Desktop Top Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop_banner",
      "label": "Desktop Bottom Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile_banner",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile_banner",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None (Transparent)"
        },
        {
          "value": "color",
          "label": "Solid Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5C567",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "NW Split Banner",
      "category": "NW SECTIONS"
    }
  ]
}
{% endschema %}
