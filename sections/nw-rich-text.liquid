{% assign shell_selector = '.nw-rich-text-wrapper.section-' | append: section.id %}
{% render 'nw-section-shell', selector: shell_selector %}
{{ 'nw-rich-text.css' | asset_url | stylesheet_tag }}

{% style %}
  {% if section.settings.overlay_enabled %}
    .nw-rich-text-wrapper.section-{{ section.id }} .nw-rich-text_bg_overlay {
      display: block;
      background-color: {{ section.settings.overlay_color | default: '#000000' }};
      opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};
    }
  {% endif %}
{% endstyle %}

<div class="nw-rich-text-wrapper section-{{ section.id }}">
  {% if section.settings.overlay_enabled %}
    <div class="nw-rich-text_bg_overlay"></div>
  {% endif %}

  <div class="page-width">
    <div class="nw-riche-text_content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% render 'nw-section-header' %}

      {% if section.settings['show-hide-btn'] and section.settings.button_text != blank %}
        <div class="nw-rich-text_cta">
          {% render 'nw-button',
            text: section.settings.button_text,
            link: section.settings.button_link,
            type: section.settings.button_type,
            icon: section.settings.btn_icon,
            align: section.settings.button_alignment
          %}
        </div>
      {% endif %}
    </div>
  </div>
</div>






{% schema %}
{
  "name": "NW Rich Text",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "TITLE"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Description</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "HEADER COLORS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#FFFEFA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFEFA"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFEFA"
    },
    {
      "type": "header",
      "content": "CTA BUTTON"
    },
    {
      "type": "checkbox",
      "label": "Show/Hide",
      "default": false,
      "id": "show-hide-btn"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "shop all skin care",
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button Type",
      "default": "primary",
      "options": [
        {
          "label": "Primary",
          "value": "primary"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        }
      ],
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "checkbox",
      "id": "btn_icon",
      "label": "Show Button Arrow Icon",
      "default": true,
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ section.settings.show-hide-btn == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND OVERLAY"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Enable Background Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None (Transparent)"
        },
        {
          "value": "color",
          "label": "Solid Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Desktop Background Image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Mobile Background Image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Top Padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Bottom Padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [],
  "tag": "section",
  "presets": [
    {
      "name": "NW Rich Text",
    "category": "NW SECTIONS"
    }
  ]
}
{% endschema %}
