    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Bottom Padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
    
  ],
  "blocks": [
    {
      "type": "nw-location-row",
      "name": "Location",
      "settings": [
        {
          "type": "header",
          "content": "EVENT LOCATION DETAILS"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "City / Country",
          "default": "City, Country"
        },
        {
          "type": "inline_richtext",
          "id": "event_date",
          "label": "Event Date",
          "default": "Sat · Jun 7"
        },
        {
          "type": "inline_richtext",
          "id": "event_venue",
          "label": "Venue / Place",
          "default": "Place"
        },
        {
          "type": "url",
