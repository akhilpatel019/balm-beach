{% assign shell_selector = '.nw-location-table.section-' | append: section.id %}
{% render 'nw-section-shell', selector: shell_selector %}
{{ 'nw-location-table.css' | asset_url | stylesheet_tag }}



<div class="nw-location-table section-{{ section.id }}">
  <div class="page-width">
    {%- liquid
      assign header_anim_class = ''
      if settings.animations_reveal_on_scroll
        assign header_anim_class = 'scroll-trigger animate--slide-in'
      endif
    -%}

    {% render 'nw-section-header', class: header_anim_class %}

    {%- if section.blocks.size > 0 -%}
      <div class="nw-location-table__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nw-location-row' -%}
            {% render 'nw-location-row', block: block, index: forloop.index %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings['show-hide-btn'] and section.settings.button_text != blank -%}
      <div
        class="nw-location-table__cta {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ section.blocks.size | plus: 1 }};"
        {% endif %}
      >
        {% render 'nw-button',
          text: section.settings.button_text,
          link: section.settings.button_link,
          type: section.settings.button_type,
          icon: section.settings.btn_icon,
          align: section.settings.button_alignment
        %}
      </div>
    {%- endif -%}
  </div>
</div>







{% schema %}
{
  "name": "NW Location Table",
  "settings": [
    
         {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
