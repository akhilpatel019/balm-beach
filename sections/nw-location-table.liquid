    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "TITLE"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Description</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "HEADER COLORS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#D88A14"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#3A2418"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#3A2418"
    },
     {
        "type": "header",
        "content": "CTA BUTTON"
    },
    {
        "type": "checkbox",
        "label": "Show/Hide",
        "default": false,
        "id": "show-hide-btn"
    },
   {
  "type": "text",
  "id": "button_text",
  "label": "Button Label",
  "default": "shop all skin care",
  "visible_if": "{{ section.settings.show-hide-btn == true }}"
},
{
  "type": "url",
  "id": "button_link",
  "label": "Button Link",
  "visible_if": "{{ section.settings.show-hide-btn == true }}"
},
{
  "type": "select",
  "id": "button_type",
