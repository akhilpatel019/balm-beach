  "tag": "section",
  "presets": [
    {
      "name": "NW Location Table",
      "category": "NW SECTIONS",
      "blocks": [
        {
          "type": "nw-location-row"
        },
         {
          "type": "nw-location-row"
        },
         {
          "type": "nw-location-row"
        }
      ]
    }
  ]
}
